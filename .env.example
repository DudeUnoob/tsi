# Firebase web configuration (these identify the Firebase project; security is
# enforced by Firebase Auth, Firestore rules, Storage rules, and App Check).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Privileged server credential, stored as one JSON string in the hosting secret
# vault. Never prefix this with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=
# For local development, prefer pointing to a downloaded service-account file
# outside the repository instead of copying its private key into this file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/tsiwebsite-service-account.json
FIREBASE_ADMIN_PROJECT_ID=tsiwebsite

# Stripe test/sandbox credentials. Keep server-side values out of NEXT_PUBLIC_*.
# Prefer a restricted test key (rk_test_...) with only the permissions needed
# for Checkout Sessions, Customers, Prices, and webhook fulfillment.
PAYMENTS_MODE=test
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# HMAC secret for customer Resume/Cancel actions. Use a different random value
# from every Firebase, Stripe, and cron credential.
CHECKOUT_TOKEN_SECRET=
# Shared secret used by the protected daily inventory-reconciliation route.
CRON_SECRET=

# Stable public origin used for Stripe success/cancel callbacks. This is
# server-only because Checkout creates absolute URLs on the server.
APP_URL=http://localhost:3000
# Optional comma-separated exact preview hosts allowed to originate Checkout
# when APP_URL and VERCEL_PROJECT_PRODUCTION_URL are both unavailable.
CHECKOUT_ALLOWED_PREVIEW_HOSTS=
